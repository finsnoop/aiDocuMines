# Settings introduced or relied on by the platform redesign.
# Copy what you need into the server's .env. Never commit real values.

# ── Language models (Assistant model list + chat) ─────────────────────────────
LLM_DEFAULT_PROVIDER=litellm            # litellm | ollama | vllm | openai
LITELLM_URL=http://aidocumines_litellm:4000/v1   # LiteLLM proxy (in-cluster name or URL)
LITELLM_API_KEY=                        # LiteLLM virtual key (LITELLM_MASTER_KEY also accepted)
OLLAMA_URL=http://aidocumines_ollama:11434
VLLM_URL=http://vllm:8000/v1
VLLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini                # deprecated by OpenAI (Nov 2026); gpt-5.6-terra is current but costs more - a cost decision
LLM_PREFERRED_MODELS=                   # optional, comma separated fallback order when no model is configured
ASSISTANT_MODEL=                        # optional: model for the context assistant
# Extra hosts users may point a provider at from the Assistant (comma-separated).
# Anything else falls back to the server default above.
LLM_ALLOWED_HOSTS=

# ── Website enquiries (contact / demo form) ───────────────────────────────────
SALES_NOTIFICATION_EMAIL=               # where new enquiries are emailed

# ── Browser origins allowed to call the API (in addition to the defaults) ─────
CORS_EXTRA_ORIGINS=                     # e.g. https://aidocumines.com,https://app.aidocumines.com

# ── Off by default; enable only deliberately ──────────────────────────────────
ENABLE_BREAK_GLASS_ENDPOINTS=false      # superuser reset / clean-db endpoints
ALLOW_DEMO_SEED=false                   # manage.py seed_demo (never on production data)

# Sign-in service (Node). New users added in Users & access are registered there.
# On CapRover use its public URL, e.g. https://aidocumines-backend.apps.example.com
NODE_BACKEND_URL=

# ── Required on every server (the API refuses to start without them) ──────────
SECRET_KEY=                             # python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False                             # never True on a public server
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
FIELD_ENCRYPTION_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                         # password for the task queue / cache (set one)
ELASTICSEARCH_PASSWORD=
ENABLE_API_DOCS=false                   # Swagger / ReDoc; keep off in production
THROTTLE_AUTH=20/min                    # sign-in, sign-up, password reset: per IP address
AUTH_MAX_FAILED_LOGINS=10               # failed sign-ins before an account pauses...
AUTH_LOCKOUT_SECONDS=900                # ...for this long
NUM_PROXIES=1                           # reverse proxies in front of the API (for per-IP limits)

# ── Capacity (fit these to the server's memory; the caps must add up to less than it) ─
WEB_CONCURRENCY=2                       # web worker processes
WEB_THREADS=8                           # threads per web worker
CELERY_CONCURRENCY=2                    # heavy jobs (OCR, translation...) running at once
CELERY_FAST_CONCURRENCY=8               # short interactive jobs at once
CELERY_MAX_MEMORY_PER_CHILD_KB=1572864  # a worker process is replaced after growing past this
CELERY_TASK_SOFT_TIME_LIMIT=10800       # seconds a single task may run (then it is failed)
CELERY_TASK_TIME_LIMIT=11400
WEB_MEM_LIMIT=3g
CELERY_MEM_LIMIT=6g
CELERY_FAST_MEM_LIMIT=3g
DB_MEM_LIMIT=2g
REDIS_MEM_LIMIT=1g
REDIS_MAXMEMORY=768mb
MILVUS_MEM_LIMIT=4g
ES_MEM_LIMIT=2g
ES_HEAP=1g
ONLYOFFICE_MEM_LIMIT=3g
OLLAMA_MEM_LIMIT=4g

# Browser PKCE and password-setting links: exact public frontend URLs.
FRONTEND_URL=https://aidocumines.com
SPA_REDIRECT_URIS=https://aidocumines.com/sign_in,http://localhost:4300/sign_in

# Database transport: managed CA paths may be supplied for verify-full.
POSTGRES_SSLMODE=require
POSTGRES_SSLROOTCERT=
ENCRYPTION_SECRET_KEY=
