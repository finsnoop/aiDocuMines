# Settings introduced or relied on by the platform redesign.
# Copy what you need into the server's .env. Never commit real values.

# ── Language models (Assistant model list + chat) ─────────────────────────────
LLM_DEFAULT_PROVIDER=litellm            # litellm | ollama | vllm | openai
LITELLM_URL=http://aidocumines_litellm:4000/v1   # LiteLLM proxy (in-cluster name or URL)
LITELLM_API_KEY=                        # LiteLLM virtual key (LITELLM_MASTER_KEY also accepted)
OLLAMA_URL=http://ollama:11434
VLLM_URL=http://vllm:8000/v1
VLLM_API_KEY=
OPENAI_API_KEY=
# Extra hosts users may point a provider at from the Assistant (comma-separated).
# Anything else falls back to the server default above.
LLM_ALLOWED_HOSTS=

# ── Website enquiries (contact / demo form) ───────────────────────────────────
SALES_NOTIFICATION_EMAIL=               # where new enquiries are emailed

# ── Browser origins allowed to call the API (in addition to the defaults) ─────
CORS_EXTRA_ORIGINS=                     # e.g. https://aidocumines.com,https://app.aidocumines.com

# ── Off by default; enable only deliberately ──────────────────────────────────
ENABLE_BREAK_GLASS_ENDPOINTS=false      # superuser reset / clean-db endpoints
ALLOW_DEMO_SEED=false                   # manage.py seed_demo (never on production data)
