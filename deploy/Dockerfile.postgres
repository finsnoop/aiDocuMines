ARG POSTGRES_BASE=postgres:15-bookworm
FROM ${POSTGRES_BASE}
USER root
RUN if command -v apk >/dev/null; then apk add --no-cache openssl; else apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*; fi
COPY deploy/postgres-tls-entrypoint.sh /usr/local/bin/aidoc-postgres-entrypoint.sh
RUN chmod 755 /usr/local/bin/aidoc-postgres-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/aidoc-postgres-entrypoint.sh"]
CMD ["postgres"]
