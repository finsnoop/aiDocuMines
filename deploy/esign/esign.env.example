# Copy to esign.env (never commit the filled-in file). Generate secrets with: openssl rand -hex 32

AIDOC_NETWORK=

# DocuSeal
DOCUSEAL_TAG=
DOCUSEAL_PUBLIC_HOST=sign-docuseal.example.com
DOCUSEAL_SECRET_KEY_BASE=
DOCUSEAL_PORT=3101

# Documenso
DOCUMENSO_TAG=
DOCUMENSO_PUBLIC_URL=https://sign-documenso.example.com
DOCUMENSO_DB_PASSWORD=
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
DOCUMENSO_CERT_FILE=./cert.p12
DOCUMENSO_SIGNING_PASSPHRASE=
DOCUMENSO_PORT=3102

# SignuDoc
SIGNUDOC_REF=
